.kiro/specs/
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Environment
.env
.env.local
.env.*.local

# Threat model exports (regenerated; not source of truth)
.threatmodel/

# Security review artifacts (internal — not shipped)
scan-report.json
scan-report-*.json
security-guardian-review.md
remediation-checklist.md

# Logs
*.log
build.log

# Local TLS cert artifacts (generated by setup-tls.sh in tmpdir; safety net)
*.pem
*.key
